<ModelBrand 
	NightLightingShadowsAllowCap="true"
	>
	<Landmark Mesh="landmarks/exploded_water_pipe_us19_objective_lmk" />

	<Subset Name="state_start" IsDefault="true">
		<Mesh Name="stage0" />
		<Mesh Name="stage0_lod1" />
		<Mesh Name="stage0_lod2" />
		<Mesh Name="stage0_lod3" />
		<CdtMesh Name="cdt_stage0" />
	</Subset>

	<Subset Name="state_end">
		<Mesh Name="stage1" />
		<Mesh Name="stage1_lod1" />
		<Mesh Name="stage1_lod2" />
		<Mesh Name="stage1_lod3" />
		<CdtMesh Name="cdt_stage1" />
		<OnSubsetActivateEvent>
			<Sound Name="actors/actor_construction/actor_construct_container_03" Range="200" Volume="1"/>
			<SFX Name="bridge_smoke_03" Dir="(0; 1; 0)" Pos="(1; 1; 1)"/>
			<SFX Name="pipe_smoke_02" Dir="(0; 1; 0)" Pos="(1; 1; 1)"/>
			
			<SFX Name="bridge_smoke_03" Dir="(0; 1; 0)" Pos="(-1; 1; 1)"/>
			<SFX Name="pipe_smoke_02" Dir="(0; 1; 0)" Pos="(-1; 1; 1)"/>
			
			<SFX Name="bridge_smoke_03" Dir="(0; 1; 0)" Pos="(1; 1; -1)"/>
			<SFX Name="pipe_smoke_02" Dir="(0; 1; 0)" Pos="(1; 1; -1)"/>
			
			<SFX Name="bridge_smoke_03" Dir="(0; 1; 0)" Pos="(-1; 1; -1)"/>
			<SFX Name="pipe_smoke_02" Dir="(0; 1; 0)" Pos="(-1; 1; -1)"/>
		</OnSubsetActivateEvent>
	</Subset>
	<PhysicsModel>
		<Body Collisions="Dynamic" ModelFrame="stage0">
			<Body Collisions="Dynamic" ModelFrame="stage1"/>
		</Body>
	</PhysicsModel>
</ModelBrand>
